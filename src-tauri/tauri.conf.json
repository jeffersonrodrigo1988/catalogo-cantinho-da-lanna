{
  "tauri": {
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.cantinhodalanna.catalogo",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [],
      "shortDescription": "Catálogo online da papelaria Cantinho da Lanna",
      "longDescription": "Aplicativo para gerenciar o catálogo de produtos da papelaria Cantinho da Lanna.",
      "windows": {
        "webviewInstallMode": {
          "type": "fixedRuntime",
          "path": "./webview2_win7"
        },
        "wix": {
          "language": ["pt-BR"]
        }
      }
    },
    "allowlist": {
      "all": true
    },
    "windows": [
      {
        "title": "Catálogo Cantinho da Lanna",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Cantinho da Lanna",
    "version": "1.0.0"
  }
}
