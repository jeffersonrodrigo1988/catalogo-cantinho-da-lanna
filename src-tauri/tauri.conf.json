{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cantinho da Lanna",
  "version": "1.0.0",
  "identifier": "com.cantinhodalanna.catalogo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Catálogo Cantinho da Lanna",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Cantinho da Lanna",
    "copyright": "© 2026 Cantinho da Lanna. Todos os direitos reservados.",
    "category": "Productivity",
    "shortDescription": "Catálogo online da papelaria Cantinho da Lanna",
    "longDescription": "Aplicativo para gerenciar o catálogo de produtos da papelaria Cantinho da Lanna.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  }
}